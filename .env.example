# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_data
DB_USER=postgres
DB_PASSWORD=your_password_here

# Optional: Alpha Vantage API key (for fallback data source)
# ALPHA_VANTAGE_API_KEY=your_key_here

# Pipeline settings
WATCHLIST=RELIANCE.NS,TCS.NS,INFY.NS
FETCH_PERIOD=6mo
FETCH_INTERVAL=1d
SCHEDULE_TIME=18:30
